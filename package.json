{
  "name": "dsh-pdf-tool",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin: parse PDF files and render pages for multimodal analysis",
  "license": "MIT",
  "author": "HyperSQ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HyperSQ/dsh-pdf-tool.git"
  },
  "bugs": {
    "url": "https://github.com/HyperSQ/dsh-pdf-tool/issues"
  },
  "homepage": "https://github.com/HyperSQ/dsh-pdf-tool#readme",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "pdf",
    "vision",
    "multimodal"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "node build.mjs",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "@napi-rs/canvas": "^0.1.100"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
